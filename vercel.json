{
    "buildCommand": "pip install -r requirements.txt",
    "functions": {
        "api/index.py": {
            "maxDuration": 60,
            "includeFiles": "{templates,css,js,posts}/**"
        }
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/api/index"
        }
    ]
}